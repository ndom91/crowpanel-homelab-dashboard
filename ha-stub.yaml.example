# Paste into the HA ESPHome add-on as the device's YAML (e.g. crowpanel.yaml).
# Everything device-specific and secret stays here, on HA. The shared,
# public pieces come from GitHub.
#
# Change settings here, Save, then Install. Layout changes come from the repo.

substitutions:
  # See README "Settings" for every option.
  ntp_server: 192.0.2.1          # LAN NTP server if the panel has no internet

  # Names and labels
  # header_title: myhome.lan
  # ha_label: ha.myhome.lan
  # svc1_name: plex              # ~9 chars; "" hides the tile
  # svc1_up_when: "on"           # "off" for problem-class sensors

  # Entities (only with data_ha.yaml)
  # entity_cpu: sensor.xxx
  # entity_mem: sensor.xxx
  # entity_gpu: sensor.xxx
  # entity_ip4: sensor.xxx
  # entity_ip6: sensor.xxx
  # entity_svc1: binary_sensor.xxx
  # entity_svc1_uptime: sensor.xxx_uptime   # boot-time sensor, for "up 12d"
  # entity_uptime: sensor.xxx_uptime        # host, for the footer

  # Tuning
  # alert_pct: "90"
  # full_refresh_every: "60"
  # offline_grace_s: "120"
  # log_level: DEBUG             # only while troubleshooting

esphome:
  name: crowpanel
  friendly_name: crowpanel

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  # domain: ".example.lan"     # if your network needs a search domain
  ap:
    ssid: crowpanel Fallback Hotspot
    password: "keep-your-generated-one"

captive_portal:

api:
  encryption:
    key: "keep-your-generated-key"

ota:
  - platform: esphome

packages:
  dashboard:
    url: https://github.com/ndom91/crowpanel-homelab-dashboard
    ref: main
    refresh: 0s   # always pull latest on build; pin a tag/SHA once stable
    files:
      - packages/board.yaml
      - packages/base.yaml
      - packages/ui.yaml
      - packages/refresh.yaml
      - packages/data_demo.yaml   # swap for packages/data_ha.yaml (README step 4)
